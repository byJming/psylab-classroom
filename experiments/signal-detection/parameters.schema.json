{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psylab.example/experiments/signal-detection/parameters.schema.json",
  "title": "信号检测参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "practiceTrials": { "type": "integer", "minimum": 6, "maximum": 18, "default": 8 },
    "testTrials": { "type": "integer", "minimum": 24, "maximum": 120, "multipleOf": 4, "default": 40 },
    "responseWindowMs": { "type": "integer", "minimum": 500, "maximum": 6000 }
  },
  "required": ["practiceTrials", "testTrials"]
}
