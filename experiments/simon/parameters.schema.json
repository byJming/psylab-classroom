{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psylab.example/experiments/simon/parameters.schema.json",
  "title": "Simon 空间相容性参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "practiceTrials": {
      "type": "integer",
      "title": "练习 trial",
      "description": "用于熟悉按颜色作答、忽略位置的规则；不进入正式摘要。",
      "default": 4,
      "minimum": 4,
      "maximum": 16
    },
    "testTrials": {
      "type": "integer",
      "title": "正式 trial",
      "description": "相容和不相容条件尽可能平衡的正式 trial 总数。",
      "default": 24,
      "minimum": 16,
      "maximum": 96,
      "multipleOf": 4
    },
    "responseWindowMs": {
      "type": "integer",
      "title": "响应窗（毫秒）",
      "description": "可选：彩色圆形出现后等待按键的时长。",
      "minimum": 500,
      "maximum": 6000
    }
  },
  "required": ["practiceTrials", "testTrials"],
  "x-psylab": {
    "preset": "public-short",
    "estimatedDurationMinutes": { "min": 4, "max": 10 },
    "responseMode": "f-j",
    "balanceRules": ["compatible=incompatible", "condition×position-cell-balanced", "color-balanced"],
    "qualityRules": ["incorrect", "no-response", "anticipation", "focus-loss"]
  }
}
