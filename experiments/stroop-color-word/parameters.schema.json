{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psylab.example/experiments/stroop-color-word/parameters.schema.json",
  "title": "颜色词 Stroop 参数",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "practiceTrials": {
      "type": "integer",
      "title": "练习 trial",
      "description": "用于熟悉颜色与按键映射；不进入正式摘要。",
      "default": 4,
      "minimum": 4,
      "maximum": 16
    },
    "testTrials": {
      "type": "integer",
      "title": "正式 trial",
      "description": "一致和不一致条件尽可能平衡的正式 trial 总数。",
      "default": 24,
      "minimum": 16,
      "maximum": 120,
      "multipleOf": 2
    },
    "responseWindowMs": {
      "type": "integer",
      "title": "响应窗（毫秒）",
      "description": "可选：颜色词出现后等待按键的时长。",
      "minimum": 500,
      "maximum": 6000
    }
  },
  "required": ["practiceTrials", "testTrials"],
  "x-psylab": {
    "preset": "public-short",
    "estimatedDurationMinutes": { "min": 5, "max": 12 },
    "responseMode": "f-j-k",
    "balanceRules": ["congruent=incongruent", "condition×color-cell-balanced"],
    "qualityRules": ["incorrect", "no-response", "anticipation", "focus-loss"]
  }
}
